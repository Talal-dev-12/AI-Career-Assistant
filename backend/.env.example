# Database & Cache Configurations
# Local default: sqlite:///./career_assistant.db
# Cloud Postgres example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./career_assistant.db
REDIS_URL=redis://localhost:6379/0

# LLM Providers (gemini or openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=
GOOGLE_CLIENT_ID=

# AWS S3 Cloud Storage (Optional - falls back to local disk uploads/ if empty)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMTP Email Dispatch Configurations (Talha Submitter Agent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# IMAP Email Tracking Configurations (Talha Tracker Agent)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
TRACKING_POLL_SECONDS=300

# API Integration & Scraping Intervals
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SCRAPE_INTERVAL_SECONDS=3600
DAILY_APPLICATION_CAP=25

# Job Board Scraping API Keys
GREENHOUSE_JOB_BOARD_API_KEY=
LEVER_POSTINGS_API_KEY=
WEBFORM_DRY_RUN=True
