# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=causer
POSTGRES_PASSWORD=capass
DATABASE_URL=postgresql://causer:capass@localhost:5432/career_assistant

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/career_assistant

# ── Elasticsearch ───────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Job Platform APIs ───────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_API_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email / SMTP ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cloud Storage ───────────────────────────────────────────────────────
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Security ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=60
ENCRYPTION_KEY=change-me-32-byte-key-for-aes256
